<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================== 权限 ==================== -->

    <!-- 悬浮窗权限 (Overlay 渲染路径，API 26+) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 电池优化豁免 (MIUI/HyperOS 防止杀进程) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 高采样率传感器 (改善陀螺仪响应) -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- 读取外部存储中的图片 (API < 33) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 恢复原来的壁纸：设置静态图片 / 恢复系统默认（普通权限，安装即授予） -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- 安卓 11+ 的包可见性：要能查到其他动态壁纸的名字和是否系统应用（恢复原来的动态壁纸用） -->
    <queries>
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
    </queries>

    <!-- ==================== 硬件特性 ==================== -->

    <!-- 陀螺仪不是必须的 (可以用触摸降级) -->
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />

    <!-- WebGL 需要 OpenGL ES 2.0 -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- ==================== 应用声明 ==================== -->

    <application
        android:name=".Wallpaper3DApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wallpaper3D">

        <!-- ========== 主界面 Activity ========== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========== 动态壁纸服务 ========== -->
        <service
            android:name=".wallpaper.LiveWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <!-- 壁纸元数据 -->
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

    </application>

</manifest>
